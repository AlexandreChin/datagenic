# datagenic — credentials for cloud storage backends.
#
# Copy this file to `.env` and fill in the values for the backend(s) you use:
#     cp .env.example .env
#
# Local generation (storage_type="local") needs NONE of these. Credentials are only
# read when you select a cloud backend. datagenic loads `.env` via python-dotenv
# (`load_dotenv()`); real environment variables work too and take precedence.
# `.env` is gitignored — never commit real secrets. This template is safe to commit.

# --- Azure Blob  (storage_type="azure_blob") ---
AZURE_STORAGE_CONNECTION_STRING=
CONTAINER_NAME=

# --- AWS S3  (storage_type="s3") ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=

# --- SFTP  (storage_type="sftp") ---
# Connection string, e.g. sftp://user:pass@host:22
SFTP_CONNECTION_STRING=
# Optional base working directory on the server
SFTP_BASE_DIR=
